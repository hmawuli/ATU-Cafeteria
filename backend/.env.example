APP_NAME="ATU Cafeteria API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Accra

LOG_CHANNEL=stack
LOG_LEVEL=info

# SQLite keeps local development lightweight on 4 GB RAM machines.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Optional integrations. Leave empty when not in use.
GEMINI_API_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Comma-separated origins for browser clients. Flutter mobile does not rely on CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=false
SANCTUM_TOKEN_EXPIRATION=1440
STUDENT_SESSION_TIMEOUT_SECONDS=900

# Authentication security
AUTH_CODE_EXPIRATION_MINUTES=10
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@atu.edu.gh
MAIL_FROM_NAME="ATU Cafeteria"
