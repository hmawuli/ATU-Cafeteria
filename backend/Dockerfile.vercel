# syntax=docker/dockerfile:1
#
# Vercel container function for the ATU Cafeteria Laravel API.
#
# This copy is used when the Vercel project's Root Directory is `backend/`
# (build context = backend/). The repository-root `Dockerfile.vercel` is used
# when Root Directory is the repository root. Both build the same image:
# Nginx + PHP-FPM in one container listening on $PORT.
#
# See docs/DEPLOY_VERCEL.md.

# ---------------------------------------------------------------------------
# Stage 1 — vendor: production Composer dependencies.
#
# Built on the SAME PHP image as the runtime so Composer's platform check and
# generated autoloader match the target exactly.
# ---------------------------------------------------------------------------
FROM composer:2 AS composer

FROM php:8.4-fpm-alpine AS vendor

RUN apk add --no-cache unzip

COPY --from=composer /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --no-scripts \
    --no-progress \
    --optimize-autoloader

# ---------------------------------------------------------------------------
# Stage 2 — runtime: Nginx + PHP-FPM serving the API on one port.
# ---------------------------------------------------------------------------
FROM php:8.4-fpm-alpine AS runtime

WORKDIR /var/www/html

# PostgreSQL extensions (need postgresql-dev/libpq) plus Nginx.
RUN set -eux; \
    apk add --no-cache --virtual .build-deps $PHPIZE_DEPS postgresql-dev; \
    docker-php-ext-install pdo_pgsql pgsql bcmath; \
    apk del .build-deps; \
    apk add --no-cache libpq nginx

# Production-tuned PHP settings for an immutable image.
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.memory_consumption=128'; \
        echo 'opcache.interned_strings_buffer=16'; \
        echo 'opcache.max_accelerated_files=10000'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'expose_php=0'; \
    } > /usr/local/etc/php/conf.d/zz-atu.ini

# Vendor from the build stage, then the application source.
COPY --from=vendor /app/vendor ./vendor
COPY . .

# Build the package manifest into the image so the read-only filesystem needs no
# bootstrap/cache write at runtime.
RUN php artisan package:discover --ansi \
    && chown -R www-data:www-data storage bootstrap/cache

COPY docker/vercel/nginx.conf.template /etc/nginx/atu-nginx.conf.template
COPY docker/vercel/php-fpm.conf /usr/local/etc/php-fpm.d/zz-atu.conf
COPY docker/vercel/start.sh /usr/local/bin/atu-start
RUN chmod +x /usr/local/bin/atu-start

EXPOSE 80

CMD ["atu-start"]
